<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">PropertyExpensesUI</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<MudPaper Width="250" Class="py-3" Elevation="0">
    <MudNavMenu Dense>
        <MudNavLink Href="/" >
            <MudIcon Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All" />
            <span>Home</span>
        </MudNavLink>
        <MudNavLink Href="/dashboard">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All" />
            <span>Dashboard</span>
        </MudNavLink>
        <MudNavLink Href="PropertyOffers" Match="NavLinkMatch.All">
            <MudIcon Icon="@Icons.Material.Filled.AddBox" />
            <span>Property Offers</span>
        </MudNavLink>
        <MudNavLink Href="counter" Match="NavLinkMatch.All">
            <MudIcon Icon="@Icons.Material.Filled.AddCircle" />
            <span>Counter</span>
        </MudNavLink>
    </MudNavMenu>
</MudPaper>

